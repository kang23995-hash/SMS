# =====================================================================
# 环境配置模板
# 用法：复制本文件为 .env，再按实际情况修改
#   Windows:  copy .env.example .env
#   Linux  :  cp .env.example .env
# 注意：.env 内含密钥，已被 .gitignore 忽略，请勿提交到代码仓库
# =====================================================================

# ---------- 服务监听 ----------
# 必须监听 0.0.0.0 才能被局域网内的手机访问；127.0.0.1 只能本机访问
APP_HOST=0.0.0.0
APP_PORT=8000
# uvicorn worker 进程数。建议 = CPU 核心数，Windows 下同样支持多 worker
# 总数据库连接数 ≈ APP_WORKERS × DB_POOL_MAX，务必小于 MySQL 的 max_connections
APP_WORKERS=4
# 单个请求最长处理时间（秒），超时直接返回 503，避免慢查询拖垮服务
APP_REQUEST_TIMEOUT=10

# ---------- 数据库 ----------
# 后端类型：mysql 或 postgresql，决定用哪个异步驱动（aiomysql / asyncpg）。
#   mysql      -> 需要 pip install aiomysql PyMySQL（requirements.txt 已含）
#   postgresql -> 需要 pip install asyncpg（requirements.txt 已含）
DB_TYPE=mysql

DB_HOST=127.0.0.1
# 端口：MySQL 默认 3306，PostgreSQL 默认 5432。
# 不写这一行时，会按 DB_TYPE 自动取默认端口；写了就以这里为准。
DB_PORT=3306
DB_USER=root
DB_PASSWORD=请填写你的MySQL密码
DB_NAME=sms_monitor

# —— 改用 PostgreSQL 时，把上面的 DB_TYPE / 端口 / 账号密码换成下面这组 ——
# DB_TYPE=postgresql
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=你的PG密码
# DB_NAME=sms_monitor
# 并先执行建库建表脚本：sql/sms_postgresql.sql

# 每个 worker 进程的连接池大小（最小/最大）
DB_POOL_MIN=1
DB_POOL_MAX=10
# 建立连接超时（秒）
DB_CONNECT_TIMEOUT=10
# 单条 SQL 执行超时（秒）
DB_QUERY_TIMEOUT=8
# 连接断开（如 MySQL server has gone away / PG 连接失效）时的自动重试次数
DB_RETRY_TIMES=3

# ---------- 安全 ----------
# 是否校验请求头 X-Token。
#   默认 false：开箱即用。
#      原因：配套的安卓 APP（SMSUploader）目前不会发送自定义请求头，
#      若开启校验，APP 上报会被一律拒绝（表现为 APP 一直重试直到超时丢弃）。
#   true：必须带正确的 X-Token 才能上报（更安全）。
#      仅在「不使用该 APP」或「已给 APP 加上 X-Token 请求头」时才建议开启。
#
# ⚠️ 无论开还是关，Web 列表页本身都没有登录认证，局域网内任何设备
#    只要知道 http://电脑IP:8000/ 就能查看全部短信内容。
API_TOKEN_ENABLED=false

# 当 API_TOKEN_ENABLED=true 时生效；必须与客户端请求头完全一致。
# 生成方法： python -c "import secrets;print(secrets.token_urlsafe(32))"
API_TOKEN=请填写一个足够随机的长字符串

# ---------- 请求限流（按客户端 IP）----------
# 单个 IP 在 RATE_LIMIT_WINDOW 秒内最多允许 RATE_LIMIT_TIMES 次上报请求
RATE_LIMIT_ENABLED=true
RATE_LIMIT_TIMES=300
RATE_LIMIT_WINDOW=60
# 是否信任 X-Forwarded-For 头。默认 false。
# 只有在服务前面挂了 Nginx 等反向代理时才改为 true ——
# 否则客户端可以伪造该头，换着假 IP 绕过上面的限流。
TRUST_PROXY_HEADERS=false

# ---------- 短信代发（qianwen_auto 人机验证）----------
# 手机设备多久没长轮询就视为离线（秒）
SMS_SEND_ONLINE_WINDOW=90
# 任务在队列里最长存活时间（秒），过期作废避免迟发失效验证码
SMS_SEND_TASK_TTL=300
# 设备领取任务后多久没回执就重新放回队列（秒）
SMS_SEND_STALE_CLAIM=90
# qianwen_auto 等待发送结果的最长时间（秒）
SMS_SEND_WAIT_TIMEOUT=180
# 手机设备单次长轮询最长挂起时间（秒，<=30）
SMS_SEND_POLL_WAIT=25
# 代发接口的 X-Token（可选）。留空 = 不校验，适合局域网直接使用；
# 填写后 send_sms APP 与 qianwen_auto 都必须带同名请求头
SMS_SEND_TOKEN=

# ---------- 其它 ----------
# 短信接收时间的时区。APP 上报带时区的 ISO-8601 时间，入库前统一转换到该时区
APP_TIMEZONE=Asia/Shanghai
# 日志级别：DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO
# 列表页默认每页条数 / 允许的最大每页条数
PAGE_SIZE_DEFAULT=20
PAGE_SIZE_MAX=100
