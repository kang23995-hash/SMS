# kimi_auto 本地私密配置模板
# 使用方法：复制本文件为 .env（与 config.py 同级），按需把下面的值改成你的真实环境。
# .env 已被 .gitignore 忽略，不会被提交。
#
# 滑块拼图人机验证需要千问视觉大模型（qwen-vl-max-latest 或 qwen2.5-vl-7b-instruct）。
# 没配 QWEN_API_KEY 时 AI 引擎跳过，只剩 OpenCV 兜底。

# ======== 千问视觉大模型（滑块拼图人机验证破解）========
# 阿里云百炼控制台申请的 API Key
QWEN_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 默认即可，如需自定义：
# QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# QWEN_MODEL=qwen-vl-max-latest

# ======== 短信系统 / 后台 ========
# 跑 FastAPI 短信系统的那台电脑的 IP（模拟器在另一台机器上，必须写 IP）
SMS_SERVER_BASE_URL=http://172.28.108.248:8000

# 后台任务系统地址
RPA_SERVICE_URL=http://localhost:8084
BACKEND_BASE_URL=http://localhost:8080

# 可选：覆盖批次大小（每手机号跑几题），默认 10
# QUESTIONS_PER_PHONE=10
