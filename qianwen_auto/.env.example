# qianwen_auto 本地私密配置模板
# 使用方法：复制本文件为 .env（与 config.py 同级），把下面的占位符替换成你的真实值。
# .env 已被 .gitignore 忽略，不会被提交。

# FastAPI 短信服务端地址（跑短信服务的那台机器 IP）
SMS_SERVER_BASE_URL=http://172.28.108.248:8000

# 人机验证「发送短信码」→ 交给局域网 send_sms 手机代发
# 改成 false 可完全跳过该验证；超时单位为秒
SMS_SEND_ENABLED=true
SMS_SEND_TIMEOUT=180
# 与 fastapi_sms 的 SMS_SEND_TOKEN 一致，留空表示不校验
SMS_SEND_TOKEN=

# RPA 服务网关地址（认领/心跳/归还）
RPA_SERVICE_URL=http://localhost:8084

# 后端回调地址（上传截图/结果回调）
BACKEND_BASE_URL=http://localhost:8080
